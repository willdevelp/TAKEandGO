generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StatutCommande {
  en_attente
  confirmee
  prete
  livree
  annulee

  @@map("statut_commande")
}

model Utilisateur {
  id              String       @id @default(uuid()) @db.Uuid
  email           String       @unique @db.VarChar(255)
  nom             String       @db.VarChar(80)
  prenom          String       @db.VarChar(80)
  telephone       String?      @db.VarChar(30)
  motDePasseHash  String       @map("mot_de_passe_hash") @db.VarChar(255)
  actif           Boolean      @default(true)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  adresses        Adresse[]

  @@map("utilisateurs")
}

model Adresse {
  id                  Int           @id @default(autoincrement())
  utilisateurId       String        @map("utilisateur_id") @db.Uuid
  rue                 String        @db.VarChar(160)
  ville               String        @db.VarChar(80)
  codePostal          String        @map("code_postal") @db.VarChar(12)
  complement          String?       @db.VarChar(160)
  utilisateur          Utilisateur   @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId])
  @@map("adresses")
}

model Categorie {
  id          Int        @id @default(autoincrement())
  nom         String     @unique @db.VarChar(80)
  produits    Produit[]

  @@map("categories")
}

model Produit {
  id            Int              @id @default(autoincrement())
  nom           String           @db.VarChar(120)
  quantite      String           @db.VarChar(40)
  prix          Decimal          @db.Decimal(10, 2)
  categorieId   Int              @map("categorie_id")
  image         String?          @db.VarChar(500)
  description   String?
  actif         Boolean          @default(true)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  categorie     Categorie        @relation(fields: [categorieId], references: [id], onDelete: Restrict)
  lignes        LigneCommande[]

  @@index([categorieId])
  @@map("produits")
}

model Commande {
  id              String          @id @default(uuid()) @db.Uuid
  nomUtilisateur  String          @map("nom_utilisateur") @db.VarChar(160)
  telephone       String?         @db.VarChar(30)
  statut          StatutCommande  @default(en_attente)
  total           Decimal         @default(0) @db.Decimal(10, 2)
  date            DateTime        @default(now())
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  lignes          LigneCommande[]

  @@index([statut])
  @@map("commandes")
}

model LigneCommande {
  id           String     @id @default(uuid()) @db.Uuid
  commandeId   String     @map("commande_id") @db.Uuid
  produitId    Int        @map("produit_id")
  quantite     Int
  prixUnitaire Decimal    @map("prix_unitaire") @db.Decimal(10, 2)
  createdAt    DateTime   @default(now()) @map("created_at")
  notes        String?
  commande     Commande   @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  produit      Produit    @relation(fields: [produitId], references: [id], onDelete: Restrict)

  @@index([commandeId])
  @@index([produitId])
  @@map("lignes_commande")
}